Cell[CellGroupData[{

Cell["Background Computation", "Subsection",
 CellChangeTimes->{{3.964278995547117*^9, 3.9642790079997272`*^9}, 
   3.9642791367628765`*^9},ExpressionUUID->"b819fd88-69a4-974e-8f8d-\
fac69aaa15c0"],

Cell[TextData[{
 "The first three sections compute the background using a power series \
expansion that starts at r=0 and extends up to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "0b2abebb-7215-f249-9574-6d40e2ca0300"],
 ".  This obtained value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "3b93740b-9107-d447-81ba-3a0e1d9f1597"],
 " is then used as the initial matching point for the numerical integration \
in the Star Profiles section, where the energy density profiles are computed. \
Finally, the last section displays the mass and charge profiles of the star."
}], "Text",
 CellChangeTimes->{{3.988820581511135*^9, 3.9888206866739235`*^9}, {
  3.988829917732046*^9, 3.9888299842712727`*^9}, {3.9888327627048283`*^9, 
  3.9888329459172935`*^9}, {3.9888355020015335`*^9, 
  3.9888355617488956`*^9}},ExpressionUUID->"4607d836-215b-2e46-96f6-\
6a17ac85ee36"],

Cell[CellGroupData[{

Cell["Series", "Subsubsection",
 CellChangeTimes->{{3.785260724467379*^9, 
  3.7852607334501333`*^9}},ExpressionUUID->"456abc3f-45d6-004b-9e45-\
73c8b9775ce2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Power", " ", "series", " ", "expansion", " ", "of", " ", "the", " ", 
    "functions", " ", "to", " ", "be", " ", "solved", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
      "using", " ", "the", " ", "boundary", " ", "conditions", " ", "to", " ",
        "have", " ", "a", " ", "soft", " ", "solution", " ", "at", " ", "r"}],
       "=", "0"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sM", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"m", "[", "n", "]"}], 
         SuperscriptBox["r", "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "3", ",", "order"}], "}"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"O", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"order", "+", "1"}], ")"}]}]}]}], " ", ";"}], " ", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sh", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"hc", "[", "n", "]"}], 
         SuperscriptBox["r", "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"O", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"order", "+", "1"}], ")"}]}]}]}], " ", ";"}], " ", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s\[Chi]", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "[", "n", "]"}], 
         SuperscriptBox["r", "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"O", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"order", "+", "1"}], ")"}]}]}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sf", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"s\[Chi]", "[", "r", "]"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", 
          FractionBox[
           RowBox[{"sM", "[", "r", "]"}], "r"]}], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"s\[Chi]", "[", "r", "]"}]}], "]"}], 
          SuperscriptBox["r", "2"], 
          SuperscriptBox[
           RowBox[{
            RowBox[{"sh", "'"}], "[", "r", "]"}], "2"]}], "+", 
         SuperscriptBox["r", "2"]}], ")"}]}], " ", "//", "Simplify"}]}], " ", 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sg", "[", "r_", "]"}], "=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", 
          FractionBox[
           RowBox[{"sM", "[", "r", "]"}], "r"]}], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"s\[Chi]", "[", "r", "]"}]}], "]"}], 
          SuperscriptBox["r", "2"], 
          SuperscriptBox[
           RowBox[{
            RowBox[{"sh", "'"}], "[", "r", "]"}], "2"]}], "+", 
         SuperscriptBox["r", "2"]}], ")"}], 
       RowBox[{"-", "1"}]], " ", "//", "Simplify"}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sEf", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"s\[Chi]", "[", "r", "]"}], "2"]}], "]"}], 
       RowBox[{
        RowBox[{"sh", "'"}], "[", "r", "]"}]}], " ", "//", "Simplify"}]}], 
    " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s\[Mu]", "[", 
      RowBox[{"r_", ",", "\[Mu]0_"}], "]"}], "=", 
     FractionBox[
      RowBox[{"\[Mu]0", "+", 
       RowBox[{"sh", "[", "r", "]"}]}], 
      SqrtBox[
       RowBox[{"sf", "[", "r", "]"}]]]}], "  ", ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"Chemical", " ", "potential", " ", 
     RowBox[{"(", 
      RowBox[{
      "Klein", " ", "relation", " ", "with", " ", "gauge", " ", "field"}], 
      ")"}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "List", " ", "of", " ", "coefficients", " ", "to", " ", "be", " ", 
     "determined", " ", "and", " ", "powers", " ", "of", " ", "r"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tpot", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       SuperscriptBox["r", "n"], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "order"}], "}"}]}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tcoef", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"m", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "3", ",", "order"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"hc", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"c", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}]}], "]"}]}], 
    " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ttodo", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"tcoef", ",", "tpot"}], "]"}]}], " ", ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Energy", " ", "and", " ", "charge", " ", "densities", " ", "expasions", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"to", " ", "agilize"}], ",", " ", 
       RowBox[{
       "we", " ", "evaluate", " ", "with", " ", "the", " ", "test", " ", 
        "values", " ", "for", " ", "future", " ", "use"}]}], ")"}]}], " ", 
    "*)"}], " ", "\n", 
   RowBox[{
    RowBox[{"s\[Rho]v", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"\[Rho]f", "[", 
           RowBox[{"s\[Mu]", "[", 
            RowBox[{"r", ",", 
             RowBox[{"\[Mu]0p", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", "tpot"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "N\[Mu]0"}], "}"}]}], "]"}], " ", "//", 
      "Simplify"}]}], " ", ";"}], "  ", "\n", 
   RowBox[{
    RowBox[{"s\[Sigma]v", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"\[Sigma]f", "[", 
           RowBox[{"s\[Mu]", "[", 
            RowBox[{"r", ",", 
             RowBox[{"\[Mu]0p", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", "tpot"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "N\[Mu]0"}], "}"}]}], "]"}], " ", "//", 
      "Simplify"}]}], " ", ";"}]}]}]], "Code",
 CellChangeTimes->{{3.782835220669547*^9, 3.7828352663769703`*^9}, {

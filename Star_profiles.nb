Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Obtained", " ", "mass", " ", 
     SubscriptBox["M", "s"]}], ",", " ", 
    RowBox[{"charge", " ", 
     SubscriptBox["Q", "s"], " ", "and", " ", 
     SubscriptBox["\[Chi]", "s"], " ", "of", " ", "the", " ", "Electron", " ",
      "Star"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Ms", "=", 
     RowBox[{
      RowBox[{"M", "[", "rf", "]"}], "/.", "Solution"}]}], "  ", ";", " ", 
    RowBox[{"Qs", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[Chi]", "[", "rf", "]"}], "2"]}], "]"}], 
       RowBox[{
        RowBox[{"h", "'"}], "[", "rf", "]"}], 
       SuperscriptBox["rf", "2"]}], "/.", "Solution"}]}], "  ", ";", " ", 
    RowBox[{"\[Chi]s", "=", 
     RowBox[{
      RowBox[{"\[Chi]", "[", "rf", "]"}], "/.", "Solution"}]}], "  ", ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Identifing", " ", "the", " ", "boundary", " ", "chemical", " ", 
     "potential", " ", 
     SubscriptBox["\[Mu]", "\[Infinity]"], " ", "and", " ", "temperature", " ", 
     SubscriptBox["T", "\[Infinity]"]}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h\[Infinity]", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"r", " ", 
           RowBox[{
            RowBox[{"Solution", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2", ",", "2"}], "]"}], "]"}], "[", "r", 
            "]"}]}], ",", "r"}], "]"}], "/.", 
        RowBox[{"r", "->", "rf"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]\[Infinity]", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"\[Chi]s", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "2"]}], "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Mu]0p", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             RowBox[{"h\[Infinity]", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}], "]"}], ",", 
       "precision"}], "]"}]}], " ", ";", "  ", 
    RowBox[{"T\[Infinity]", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[Chi]s", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "2"]}], "]"}], 
        RowBox[{"T0p", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}]}], "  ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Plot", " ", "of", " ", "the", " ", "Katz", " ", "criteria"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"katz", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"T\[Infinity]", "[", 
           RowBox[{"[", "i", "]"}], "]"}]], ",", 
         RowBox[{"-", 
          RowBox[{"Ms", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}]}], "  ", ";"}], "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"katz", ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*FractionBox[\(1\), SubscriptBox[\(T\), \
\(\[Infinity]\)]]\)\>\"", 
        ",", "\"\<-\!\(\*SubscriptBox[\(M\), \(s\)]\)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Stability: Katz Criteria\>\""}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"\"\<\!\(\*FractionBox[\(\[Mu]\), \(T\)]\)=\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", "\[Alpha]", "]"}], "]"}]}]}], ",", 
     RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}]}]], "Input",

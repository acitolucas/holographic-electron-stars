Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Electron", " ", "star", " ", "anzat"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"\[Chi]", "[", "r", "]"}], "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", 
          RowBox[{"M", "[", "r", "]"}]}], "r"], "+", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"\[Chi]", "[", "r", "]"}]}], "]"}], 
         SuperscriptBox["r", "2"], 
         SuperscriptBox[
          RowBox[{
           RowBox[{"h", "'"}], "[", "r", "]"}], "2"]}], "+", 
        SuperscriptBox["r", "2"]}], ")"}]}]}], "  ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "r_", "]"}], "=", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", 
          RowBox[{"M", "[", "r", "]"}]}], "r"], "+", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"\[Chi]", "[", "r", "]"}]}], "]"}], 
         SuperscriptBox["r", "2"], 
         SuperscriptBox[
          RowBox[{
           RowBox[{"h", "'"}], "[", "r", "]"}], "2"]}], "+", 
        SuperscriptBox["r", "2"]}], ")"}], 
      RowBox[{"-", "1"}]]}], "  ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ef", "[", "r_", "]"}], "=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"\[Chi]", "[", "r", "]"}], "2"]}], "]"}], 
      RowBox[{
       RowBox[{"h", "'"}], "[", "r", "]"}]}]}], "  ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Mu]", "[", "r_", "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"\[Mu]0p", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "+", 
         RowBox[{"h", "[", "r", "]"}], " "}], 
        SqrtBox[
         RowBox[{"f", "[", "r", "]"}]]], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}]}], " ", ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{"Local", " ", "chemical", " ", "potential", " ", "definition"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"T", "[", "r_", "]"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"T0p", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        SqrtBox[
         RowBox[{"f", "[", "r", "]"}]]], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}]}], " ", ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Temperature", " ", 
     RowBox[{"(", 
      RowBox[{"from", " ", "Tolman", " ", "relation"}], ")"}]}], "  ", "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\[Rho]", ",", " ", 
     RowBox[{"P", " ", "and", " ", "\[Sigma]", " ", "integrals"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{
      RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
      RowBox[{"T_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Gamma]", "2"], 
         SuperscriptBox["\[Epsilon]", "2"], 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Epsilon]", "2"], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "-", "\[Mu]"}], "T"], "]"}], "+", "1"}]],
            "+", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "+", "\[Mu]"}], "T"], "]"}], "+", 
             "1"}]]}], ")"}]}], " ", ",", "precision"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", "1", ",", "\[Infinity]"}], "}"}], ",", 
      RowBox[{"AccuracyGoal", "->", "\[Infinity]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P", "[", 
     RowBox[{
      RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
      RowBox[{"T_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox["\[Gamma]", "2"], "3"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Epsilon]", "2"], "-", "1"}], ")"}], 
          FractionBox["3", "2"]], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "-", "\[Mu]"}], "T"], "]"}], "+", "1"}]],
            "+", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "+", "\[Mu]"}], "T"], "]"}], "+", 
             "1"}]]}], ")"}]}], ",", "precision"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", "1", ",", "\[Infinity]"}], "}"}], ",", 
      RowBox[{"AccuracyGoal", "->", "\[Infinity]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", 
     RowBox[{
      RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
      RowBox[{"T_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox["\[Gamma]", "2"], "mt"], "\[Epsilon]", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Epsilon]", "2"], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "-", "\[Mu]"}], "T"], "]"}], "+", "1"}]],
            "-", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "+", "\[Mu]"}], "T"], "]"}], "+", 
             "1"}]]}], ")"}]}], " ", ",", "precision"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", "1", ",", "\[Infinity]"}], "}"}], ",", 
      RowBox[{"AccuracyGoal", "->", "\[Infinity]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rf", "=", "10"}], " ", ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"cut", "-", 
     RowBox[{
     "off", " ", "for", " ", "the", " ", "numerical", " ", "solution"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Solution", "=", 

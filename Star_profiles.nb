      RowBox[{"AccuracyGoal", "->", "\[Infinity]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rf", "=", "5"}], " ", ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{"cut", "-", 
     RowBox[{
     "off", " ", "for", " ", "the", " ", "numerical", " ", "solution"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Solution", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"M", "'"}], "[", "r", "]"}], "\[Equal]", " ", 
            RowBox[{
             FractionBox[
              SuperscriptBox["r", "2"], "2"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Rho]", "[", 
                RowBox[{
                 RowBox[{"\[Mu]", "[", "r", "]"}], ",", 
                 RowBox[{"T", "[", "r", "]"}]}], "]"}], "+", 
               RowBox[{"2", "r", " ", 
                RowBox[{"Ef", "[", "r", "]"}], 
                SqrtBox[
                 RowBox[{"g", "[", "r", "]"}]], " ", 
                RowBox[{"\[Sigma]", "[", 
                 RowBox[{
                  RowBox[{"\[Mu]", "[", "r", "]"}], ",", 
                  RowBox[{"T", "[", "r", "]"}]}], "]"}]}]}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Ef", "'"}], "[", "r", "]"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 

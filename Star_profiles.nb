Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Full", " ", "obtained", " ", "density", " ", "profiles", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"from", " ", "r"}], "=", 
      RowBox[{
       RowBox[{"0", " ", "to", " ", "r"}], "=", 
       SubscriptBox["r", "f"]}]}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]full", "=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Normal", "[", "s\[Rho]v", "]"}], "/.", "rbackground"}], ",", 
          RowBox[{"0", "\[LessEqual]", "r", "\[LessEqual]", "ri"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", 
             RowBox[{
              RowBox[{"\[Mu]", "[", "r", "]"}], ",", 
              RowBox[{"T", "[", "r", "]"}]}], "]"}], "/.", "Solution"}], 
           "]"}], ",", 
          RowBox[{"ri", "<=", "r", "\[LessEqual]", "rf"}]}], "}"}]}], "}"}], 
      "]"}]}], "  ", ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "we", " ", "stop", " ", "the", " ", "numerical", " ", "resolution", " ", 
      "if", " ", "the", " ", "Star", " ", "density", " ", "decays", " ", "at",
       " ", "least", " ", "10", " ", "order", " ", "of", " ", "magnitude", " ",
       "at", " ", "the", " ", "cut"}], "-", 
     RowBox[{"off", " ", 
      SubscriptBox["r", "f"]}]}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]full", "/.", 
         RowBox[{"r", "->", "rf"}]}], 
        RowBox[{"\[Rho]full", "/.", 
         RowBox[{"r", "->", "0"}]}]], ",", 
       RowBox[{
        RowBox[{"#", ">", 
         SuperscriptBox["10", 
          RowBox[{"-", "10"}]]}], "&"}]}], "]"}], 
     ",", "\"\<the cut-off \!\(\*SubscriptBox[\(r\), \(f\)]\) must be \
bigger\>\""}], "]"}], " ", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "PLOTS", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", "\[Rho]full", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "rf"}], "}"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(T\), \(0\)]\) = \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", "T0p", "]"}], "]"}], 
       "<>", "\"\< & \!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\) = \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"N", "[", "\[Mu]0p", "]"}], "]"}]}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", "\"\<Log \[Rho]\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], " "}]}]], "Input",

             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "-", "\[Mu]"}], "T"], "]"}], "+", "1"}]],
            "-", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "+", "\[Mu]"}], "T"], "]"}], "+", 

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Full", " ", "obtained", " ", "density", " ", "profiles", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"from", " ", "r"}], "=", 
      RowBox[{
       RowBox[{"0", " ", "to", " ", "r"}], "=", 
       SubscriptBox["r", "f"]}]}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]full", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Normal", "[", 
              RowBox[{"s\[Rho]v", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "/.", 
             RowBox[{"rbackground", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", 
            RowBox[{"0", "\[LessEqual]", "r", "\[LessEqual]", 
             RowBox[{"ri", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Evaluate", "[", 
             RowBox[{
              RowBox[{"\[Rho]", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Mu]", "[", "r", "]"}], "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"T", "[", "r", "]"}], "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "/.", 
              RowBox[{"Solution", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"ri", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "<=", "r", "\[LessEqual]", 
             "rf"}]}], "}"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}]}], "  ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "we", " ", "stop", " ", "the", " ", "numerical", " ", "resolution", " ", 
      "if", " ", "the", " ", "Star", " ", "density", " ", "decays", " ", "at",
       " ", "least", " ", "10", " ", "order", " ", "of", " ", "magnitude", " ",
       "at", " ", "the", " ", "cut"}], "-", 
     RowBox[{"off", " ", 
      SubscriptBox["r", "f"]}]}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"\[Rho]full", "/.", 
         RowBox[{"r", "->", "rf"}]}], 
        RowBox[{"\[Rho]full", "/.", 
         RowBox[{"r", "->", "0"}]}]], ",", 
       RowBox[{
        RowBox[{"#", ">", 
         SuperscriptBox["10", 
          RowBox[{"-", "10"}]]}], "&"}]}], "]"}], 
     ",", "\"\<the cut-off \!\(\*SubscriptBox[\(r\), \(f\)]\) must be \
bigger\>\""}], "]"}], " ", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "PLOTS", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"\[Rho]full", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "rf"}], "}"}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(T\), \(0\)]\) = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"N", "[", 
           RowBox[{"T0p", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], 
         "<>", "\"\< & \!\(\*SubscriptBox[\(\[Mu]\), \(0\)]\) = \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"N", "[", 
           RowBox[{"\[Mu]0p", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", "\"\<Log \[Rho]\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}], " "}]}]], "Input",

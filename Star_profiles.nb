      RowBox[{"\[Mu]_", "?", "NumericQ"}], ",", 
      RowBox[{"T_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{
         FractionBox[

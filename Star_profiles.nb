Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Power", " ", "series", " ", "expansion", " ", "of", " ", "the", " ", 
    "functions", " ", "to", " ", "be", " ", "solved", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
      "using", " ", "the", " ", "boundary", " ", "conditions", " ", "to", " ",
        "have", " ", "a", " ", "soft", " ", "solution", " ", "at", " ", "r"}],
       "=", "0"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sM", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"m", "[", "n", "]"}], 
         SuperscriptBox["r", "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "3", ",", "order"}], "}"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"O", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"order", "+", "1"}], ")"}]}]}]}], " ", ";"}], " ", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sh", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"hc", "[", "n", "]"}], 
         SuperscriptBox["r", "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"O", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"order", "+", "1"}], ")"}]}]}]}], " ", ";"}], " ", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s\[Chi]", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "[", "n", "]"}], 
         SuperscriptBox["r", "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"O", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"order", "+", "1"}], ")"}]}]}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sf", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"s\[Chi]", "[", "r", "]"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", 
          FractionBox[
           RowBox[{"sM", "[", "r", "]"}], "r"]}], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"s\[Chi]", "[", "r", "]"}]}], "]"}], 
          SuperscriptBox["r", "2"], 
          SuperscriptBox[
           RowBox[{
            RowBox[{"sh", "'"}], "[", "r", "]"}], "2"]}], "+", 
         SuperscriptBox["r", "2"]}], ")"}]}], " ", "//", "Simplify"}]}], " ", 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sg", "[", "r_", "]"}], "=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", 
          FractionBox[
           RowBox[{"sM", "[", "r", "]"}], "r"]}], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"s\[Chi]", "[", "r", "]"}]}], "]"}], 
          SuperscriptBox["r", "2"], 
          SuperscriptBox[
           RowBox[{
            RowBox[{"sh", "'"}], "[", "r", "]"}], "2"]}], "+", 
         SuperscriptBox["r", "2"]}], ")"}], 
       RowBox[{"-", "1"}]], " ", "//", "Simplify"}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sEf", "[", "r_", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"s\[Chi]", "[", "r", "]"}], "2"]}], "]"}], 
       RowBox[{
        RowBox[{"sh", "'"}], "[", "r", "]"}]}], " ", "//", "Simplify"}]}], 
    " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s\[Mu]", "[", 
      RowBox[{"r_", ",", "\[Mu]0_"}], "]"}], "=", 
     FractionBox[
      RowBox[{"\[Mu]0", "+", 
       RowBox[{"sh", "[", "r", "]"}]}], 
      SqrtBox[
       RowBox[{"sf", "[", "r", "]"}]]]}], "  ", ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"Chemical", " ", "potential", " ", 
     RowBox[{"(", 
      RowBox[{
      "Klein", " ", "relation", " ", "with", " ", "gauge", " ", "field"}], 
      ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sT", "[", 
      RowBox[{"r_", ",", "T0_"}], "]"}], "=", 
     FractionBox["T0", 
      SqrtBox[
       RowBox[{"sf", "[", "r", "]"}]]]}], "  ", ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"Temperature", " ", 
     RowBox[{"(", 
      RowBox[{"Tolman", " ", "relation"}], ")"}]}], " ", "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "List", " ", "of", " ", "coefficients", " ", "to", " ", "be", " ", 
     "determined", " ", "and", " ", "powers", " ", "of", " ", "r"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"tpot", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       SuperscriptBox["r", "n"], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "order"}], "}"}]}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tcoef", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"m", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "3", ",", "order"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"hc", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"c", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "2", ",", "order"}], "}"}]}], "]"}]}], "]"}]}], 
    " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ttodo", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"tcoef", ",", "tpot"}], "]"}]}], " ", ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Energy", " ", "density"}], ",", " ", 
     RowBox[{
     "Pressure", " ", "and", " ", "charge", " ", "density", " ", 
      "expasions"}]}], " ", "*)"}], " ", " ", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s\[Rho]", "[", 
      RowBox[{"\[Mu]0_", ",", "T0_"}], "]"}], ":=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Gamma]", "2"], 
         SuperscriptBox["\[Epsilon]", "2"], 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Epsilon]", "2"], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "-", 
                RowBox[{"s\[Mu]", "[", 
                 RowBox[{"r", ",", "\[Mu]0"}], "]"}]}], 
               RowBox[{"sT", "[", 
                RowBox[{"r", ",", "T0"}], "]"}]], "]"}], "+", "1"}]], "+", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "+", 
                RowBox[{"s\[Mu]", "[", 
                 RowBox[{"r", ",", "\[Mu]0"}], "]"}]}], 
               RowBox[{"sT", "[", 
                RowBox[{"r", ",", "T0"}], "]"}]], "]"}], "+", "1"}]]}], 
          ")"}]}], " ", "//", "Expand"}], ",", "ttodo", ",", 
       RowBox[{
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"NIntegrate", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"\[Epsilon]", ",", "1", ",", "\[Infinity]"}], "}"}], ",", 
            RowBox[{"AccuracyGoal", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}], ",", 
          "precision"}], "]"}], "&"}]}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sP", "[", 
      RowBox[{"\[Mu]0_", ",", "T0_"}], "]"}], ":=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox["\[Gamma]", "2"], "3"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[Epsilon]", "2"], "-", "1"}], ")"}], 
          FractionBox["3", "2"]], " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "-", 
                RowBox[{"s\[Mu]", "[", 
                 RowBox[{"r", ",", "\[Mu]0"}], "]"}]}], 
               RowBox[{"sT", "[", 
                RowBox[{"r", ",", "T0"}], "]"}]], "]"}], "+", "1"}]], "+", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "+", 
                RowBox[{"s\[Mu]", "[", 
                 RowBox[{"r", ",", "\[Mu]0"}], "]"}]}], 
               RowBox[{"sT", "[", 
                RowBox[{"r", ",", "T0"}], "]"}]], "]"}], "+", "1"}]]}], 
          ")"}]}], " ", "//", "Expand"}], ",", "ttodo", ",", 
       RowBox[{
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"NIntegrate", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"\[Epsilon]", ",", "1", ",", "\[Infinity]"}], "}"}], ",", 
            RowBox[{"AccuracyGoal", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}], ",", 
          "precision"}], "]"}], "&"}]}], "]"}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s\[Sigma]", "[", 
      RowBox[{"\[Mu]0_", ",", "T0_"}], "]"}], ":=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox["\[Gamma]", "2"], "mt"], "\[Epsilon]", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Epsilon]", "2"], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "-", 
                RowBox[{"s\[Mu]", "[", 
                 RowBox[{"r", ",", "\[Mu]0"}], "]"}]}], 
               RowBox[{"sT", "[", 
                RowBox[{"r", ",", "T0"}], "]"}]], "]"}], "+", "1"}]], "-", 
           FractionBox["1", 
            RowBox[{
             RowBox[{"Exp", "[", 
              FractionBox[
               RowBox[{"\[Epsilon]", "+", 
                RowBox[{"s\[Mu]", "[", 
                 RowBox[{"r", ",", "\[Mu]0"}], "]"}]}], 
               RowBox[{"sT", "[", 
                RowBox[{"r", ",", "T0"}], "]"}]], "]"}], "+", "1"}]]}], 
          ")"}]}], " ", "//", "Expand"}], ",", " ", "ttodo", ",", 
       RowBox[{
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"NIntegrate", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"\[Epsilon]", ",", "1", ",", "\[Infinity]"}], "}"}], ",", 
            RowBox[{"AccuracyGoal", "\[Rule]", "\[Infinity]"}], ",", 

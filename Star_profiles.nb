Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Free", " ", "energy", " ", "of", " ", "the", " ", "Star"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]full", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"p\[Chi]", "[", "r", "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"0", "<=", "r", "\[LessEqual]", 
             RowBox[{"ri", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Solution", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "3", ",", "2"}], "]"}], "]"}], "[", "r", 
             "]"}], ",", 
            RowBox[{
             RowBox[{"ri", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "<", "r", "<=", "rf"}]}], 
           "}"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NT0"}], "}"}]}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hfull", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"ph", "[", "r", "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"0", "<=", "r", "\[LessEqual]", 
             RowBox[{"ri", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
